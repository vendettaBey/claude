# Laravel API kök adresi.
# Boş bırakılırsa istekler aynı origin'e (/api/v1/...) gider — Nginx arkasında
# tek alan adı kullanıldığında önerilen ayardır.
VITE_API_BASE_URL=

# Yalnızca geliştirme: vite dev sunucusunun /api isteklerini yönlendireceği hedef.
VITE_DEV_API_PROXY=http://localhost:8000

# Sitenin herkese açık adresi (canonical, sitemap ve schema için).
VITE_SITE_URL=https://ulkuyazilim.com
