{
  "name": "ulku-yazilim-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ülkü Yazılım kurumsal web sitesi — React 19 + TypeScript + Vite arayüzü",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:sites": "npm run build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc -b",
    "images": "node scripts/generate-images.mjs",
    "prerender": "node scripts/prerender.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/sora": "^5.2.5",
    "@hookform/resolvers": "^5.5.7",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/fiber": "^9.7.0",
    "axios": "^1.19.0",
    "framer-motion": "^12.4.7",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "^7.2.0",
    "three": "0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
