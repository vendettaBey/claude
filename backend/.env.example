APP_NAME="Ülkü Yazılım"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Veritabanı --------------------------------------------------------------
# Yerelde hızlı başlangıç için sqlite bırakılabilir; üretimde mysql kullanın.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ulku_yazilim
DB_USERNAME=ulku
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Bildirim e-postalarını arka plana almak için: redis veya database
QUEUE_CONNECTION=sync

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-posta -----------------------------------------------------------------
# Yerelde "log" sürücüsü ile e-postalar storage/logs içine yazılır.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="site@ulkuyazilim.com"
MAIL_FROM_NAME="${APP_NAME}"

# Teklif formundan gelen taleplerin bildirileceği adres.
QUOTE_REQUEST_RECIPIENT=info@ulkuyazilim.com

# --- Frontend / CORS ---------------------------------------------------------
# Frontend ayrı bir alan adında sunuluyorsa tam origin yazın (virgülle çoklu).
# Aynı alan adı kullanılıyorsa boş bırakın.
FRONTEND_URL=http://localhost:5173

# Nginx / Cloudflare arkasında güvenilen proxy aralıkları.
# Üretimde "*" yerine kendi proxy IP aralığınızı yazın.
TRUSTED_PROXIES=*
